{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "16 || 18"
  },
  "scripts": {
    "dev": "concurrently \"yarn start\" \"yarn start-backend\"",
    "start": "yarn workspace app start",
    "start-backend": "yarn workspace backend start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new --scope internal"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "^0.22.4",
    "@spotify/prettier-config": "^12.0.0",
    "concurrently": "^6.0.0",
    "lerna": "^4.0.0",
    "node-gyp": "^9.0.0",
    "prettier": "^2.3.2",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@types/react": "^17",
    "@types/react-dom": "^17",
    "@azure/identity": "4.2.1",
    "@backstage/backend-app-api": "0.5.9",
    "@cypress/request": "3.0.0",
    "@grpc/grpc-js": "1.13.6",
    "@octokit/plugin-paginate-rest": "9.2.2",
    "@remix-run/router": "1.23.3",
    "@tootallnate/once": "2.0.1",
    "@xmldom/xmldom": "0.8.15",
    "axios": "1.20.0",
    "body-parser": "1.20.3",
    "cookie": "0.7.0",
    "decode-uri-component": "0.5.0",
    "dompurify": "3.4.17",
    "esbuild": "0.25.0",
    "fast-xml-parser": "5.7.0",
    "file-type": "21.3.1",
    "form-data": "4.0.6",
    "js-cookie": "3.0.6",
    "js-yaml": "4.3.2",
    "jsonpath-plus": "10.3.0",
    "linkify-it": "5.0.2",
    "markdown-it": "14.3.3",
    "minimatch": "7.4.8",
    "octokit": "3.1.2",
    "on-headers": "1.1.0",
    "parse-path": "5.0.0",
    "parse-url": "8.1.0",
    "prismjs": "1.30.0",
    "protobufjs-cli": "1.3.3",
    "protobufjs": "7.6.3",
    "qs": "6.16.0",
    "send": "0.19.0",
    "serialize-javascript": "7.1.3",
    "serve-static": "1.16.0",
    "tar-fs": "2.1.4",
    "tar": "7.5.18",
    "tmp": "0.2.6",
    "tough-cookie": "4.1.3",
    "uuid": "11.1.1",
    "webpack-dev-middleware": "7.4.5",
    "webpack-dev-server": "5.2.6",
    "xml2js": "0.5.0",
    "@backstage/backend-tasks/@backstage/backend-common": "0.19.10",
    "@backstage/plugin-auth-node/@backstage/backend-common": "0.19.10",
    "@backstage/plugin-permission-node/@backstage/backend-common": "0.19.10",
    "@backstage/plugin-search-backend-module-pg/@backstage/backend-common": "0.19.10",
    "@backstage/plugin-search-backend-node/@backstage/backend-common": "0.19.10"
  },
  "prettier": "@spotify/prettier-config",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
